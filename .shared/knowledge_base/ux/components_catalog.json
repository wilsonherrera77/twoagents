  "wcag_2_1_checklist": {
    "level_a": [
      "Text alternatives for images (alt text)",
      "Captions for video/audio",
      "Semantic HTML structure",
      "Keyboard accessible",
      "No keyboard traps",
      "Adjustable time limits",
      "Pause/stop animations",
      "No seizure-inducing flashes"

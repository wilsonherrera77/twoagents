{
  "version": "1.0",
  "framework_templates": {
    "react_tailwind": {
      "name": "React + Tailwind CSS",
      "description": "Modern React components with Tailwind utility classes",
      "components": [
        "Button", "Card", "Modal", "Form", "Table", "Navigation",
        "Dropdown", "Toast", "Tabs", "Accordion", "Avatar", "Badge"
      ],
      "features": [
        "Responsive design (sm, md, lg, xl breakpoints)",
        "Dark mode support",
        "Accessibility (ARIA labels, keyboard nav)",
        "Component composition"
      ]
    },
    "vue_tailwind": {
      "name": "Vue 3 + Tailwind CSS",
      "description": "Vue 3 Composition API with Tailwind",
      "components": [
        "VButton", "VCard", "VModal", "VForm", "VTable",
        "VNav", "VDropdown", "VToast", "VTabs"
      ]
    },
    "shadcn_ui": {
      "name": "Shadcn/UI (React)",

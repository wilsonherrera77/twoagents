      "components": [
        "AlertDialog", "Avatar", "Button", "Calendar", "Card",
        "Checkbox", "Dialog", "DropdownMenu", "Form", "Input",
        "Label", "Select", "Sheet", "Table", "Toast", "Tooltip"
      ],
      "features": [
        "Fully accessible (WCAG 2.1 AA)",
        "Customizable and themeable",
        "TypeScript support",
        "Server Components compatible"
      ]
    }
  },
  "design_patterns": {

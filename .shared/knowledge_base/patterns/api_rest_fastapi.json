{
  "project_type": "api_rest",
  "framework": "fastapi",
  "description": "Enterprise-grade REST API with FastAPI",
  "required_files": [
    "main.py",
    "config.py",
    "models.py",
    "schemas.py",
    "routes.py",
    "database.py",
    "dependencies.py",
    "security.py",
    "middleware.py",
    "tests/conftest.py",
    "tests/test_routes.py",
    "tests/test_security.py",
    "tests/load/locustfile.py",
    "alembic/env.py",
    ".github/workflows/ci.yml",
    "Dockerfile",
    "docker-compose.yml",
    "requirements.txt",
    "requirements-dev.txt",
    ".env.example",
    "README.md",
    "SECURITY.md"
  ],
  "mandatory_features": {
    "database": {
      "orm": "sqlalchemy",
      "migrations": "alembic",
      "pool_size": 20,
      "async_support": true,
      "must_have": ["connection pooling", "transactions", "indexes"]
    },
    "security": {
      "authentication": "JWT",
      "password_hashing": "bcrypt",
      "cors": {
        "allow_origins": ["https://yourdomain.com"],
        "allow_credentials": true,
        "allow_methods": ["GET", "POST", "PUT", "DELETE"],
        "max_age": 3600
      },
      "rate_limiting": {
        "requests_per_minute": 100,
        "burst": 20
      },
      "secrets_manager": "environment_variables",
      "must_have": ["JWT tokens", "password hashing", "CORS restrictions", "rate limiting", "input validation"]
    },
    "observability": {
      "logging": {
        "format": "json",
        "level": "INFO",
        "destination": "stdout+file",
        "structured": true
      },
      "metrics": {
        "provider": "prometheus",
        "endpoint": "/metrics",
        "must_track": ["request_count", "request_duration", "error_rate"]
      },
      "tracing": {
        "provider": "opentelemetry",
        "export_to": "jaeger",
        "sample_rate": 0.1
      }
    },
    "testing": {
      "unit_coverage_min": 95,
      "integration_tests": true,
      "load_tests": {
        "tool": "locust",
        "target_rps": 1000,
        "target_p95": 150
      },
      "must_have": ["unit tests", "integration tests", "load tests", "fixtures"]
    },
    "ci_cd": {
      "provider": "github_actions",
      "stages": ["lint", "test", "security_scan", "build", "deploy"],
      "must_have": ["automated tests", "docker build", "code coverage"]
    },
    "documentation": {
      "must_have": ["README.md", "API documentation", "SECURITY.md", "docstrings"]
    }
  },
  "quality_gates": {
    "security_score": 9.0,
    "test_coverage": 95.0,
    "code_complexity": 10,
    "response_time_p95": 150,
    "throughput_min": 1000
  }
}
